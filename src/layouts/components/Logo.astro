---
import config from "@/config/config.json";
import ImageMod from "./ImageMod.astro";

const { src }: { src?: string } = Astro.props;
const {
  logo,
  logo_width,
  logo_text,
  title,
}: {
  logo: string;
  logo_width: string;
  logo_text: string;
  title: string;
} = config.site;

// The source art is 320×62 (viewBox 665×128). Display width stays logo_width;
// height follows that ratio so the mark is not stretched.
const displayWidth = Number(String(logo_width).replace("px", "")) || 160;
const naturalWidth = 320;
const naturalHeight = 62;
const displayHeight = Math.round((displayWidth * naturalHeight) / naturalWidth);
---

<a href="/" class="navbar-brand inline-block">
  {
    src || logo ? (
      <>
        <ImageMod
          src={src ? src : logo}
          class="inline-block"
          width={naturalWidth}
          height={naturalHeight}
          alt={title}
          priority={true}
          style={{
            height: displayHeight + "px",
            width: displayWidth + "px",
          }}
          format="webp"
        />
      </>
    ) : logo_text ? (
      logo_text
    ) : (
      title
    )
  }
</a>
